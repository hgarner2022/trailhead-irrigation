# Feature flags. Both stay unset until the matching phase ships; production turns them on last.
# Opens /season-pass/checkout; unset, the route returns the branded 404.
SEASON_PASS_CHECKOUT=
# Swaps the Jobber iframe at /book for the app's own booking form.
APP_BOOKING=

# Database (Phase 3). The Neon connection string; `npx vercel env pull .env.local` fetches it. Used by src/db, drizzle.config.ts and `npm run db:migrate`.
DATABASE_URL=
# Comma-separated emails seeded as admins by `npm run db:seed` (scripts/db-seed.ts).
SEED_ADMINS=
# Set to "yes" to seed the fixture passes, customers and visits as well (development branch only).
SEED_FIXTURE_PASSES=

# Sign-in and API keys (Phase 4). Auth.js signs the session cookie with AUTH_SECRET (`npx auth secret` or `openssl rand -base64 32`).
AUTH_SECRET=
# The site's origin for magic links (https://www.trailheadirrigation.com in production). Optional on Vercel, which Auth.js infers.
AUTH_URL=
# Mixed into every API key's hash (`openssl rand -base64 32`). Changing it revokes every key.
API_KEY_PEPPER=
# Sign-in emails go out through the same Resend key as every other email.
RESEND_API_KEY=

# Jobber read-only and geocoding (Phase 6). `/api/cron/*` accepts only `Authorization: Bearer <CRON_SECRET>`, which Vercel Cron sends when this is set (`openssl rand -base64 32`).
CRON_SECRET=
# An email address for the Nominatim User-Agent, so OpenStreetMap can reach us if the usage ever needs a word.
GEOCODE_CONTACT=

# Stripe (Phase 7). Test keys (sk_test_..., pk_test_...) everywhere until Hannah goes live; the dashboard's Developers page has them.
STRIPE_SECRET_KEY=
# The publishable key Stripe.js uses in the browser (Phase 8's embedded card step). Safe to expose.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# The signing secret (whsec_...) of the endpoint https://<site>/api/webhooks/stripe, which listens for checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed and payment_method.detached.
STRIPE_WEBHOOK_SECRET=
# The site's origin, no trailing slash. Links in messages and the card-update return page are built from it.
APP_URL=
