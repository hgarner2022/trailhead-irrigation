# Feature flags. Both stay unset until the matching phase ships; production turns them on last.
# Opens /season-pass/checkout; unset, the route returns the branded 404.
SEASON_PASS_CHECKOUT=
# Swaps the Jobber iframe at /book for the app's own booking form.
APP_BOOKING=

# Database (Phase 3). The Neon connection string; `npx vercel env pull .env.local` fetches it. Used by src/db, drizzle.config.ts and `npm run db:migrate`.
DATABASE_URL=
# Comma-separated emails seeded as admins by `npm run db:seed` (scripts/db-seed.ts).
SEED_ADMINS=
# Set to "yes" to seed the fixture passes, customers and visits as well (development branch only).
SEED_FIXTURE_PASSES=
